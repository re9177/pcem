<!-- This is an example of what the new configuration code might write out -->
<machine board="shuttle">
	<!-- baseboard config -->
	<config>
		<memory-size>64M</memory-size>
	</config>
	<!-- device tree -->
	<devices>
		<bus kind="ide">
			<device kind="hdd" addr="0.0">
				<drive kind="file">
					<path>/home/lily/bla.vhd</path>
				</drive>
			</device>

			<device kind="cdrom-atapi" addr="1.0">
				<type>dvdrom</type>
			</device>
		</bus>

		<!-- no ISA devices besides the machine's -->
		<bus kind="isa"/>

		<bus kind="pci">
			<device kind="rtl8139" addr="1">
				<network kind="slirp">
					<baseip>10.69.0.0</baseip>
				</network>
			</device>
		</bus>
	</devices>
</machine>


<!-- Another example, this time showing SCSI assignments -->
<machine board="shuttle">
	<!-- baseboard config -->
	<config>
		<memory-size>64M</memory-size>
	</config>
	<!-- device tree -->
	<devices>
		<bus kind="ide">
			<device kind="hdd" addr="0.0">
				<drive kind="file">
					<path>/home/lily/bla.vhd</path>
				</drive>
			</device>

			<device kind="cdrom-atapi" addr="1.0">
				<type>dvdrom</type>
			</device>
		</bus>

		<bus kind="scsi">
			<!-- using a partial ctds format (c,t,d) for addressing,
				so controllers can co-exist). A cleaner way of doing this
				might be to put the <bus> in each controller instance, allowing
				ommision of (c, t), and only specifying (d), which is the LUN, i think? -->
			<device kind="hdd" addr="0.0.0">
				<drive kind="file">
				<path>/home/lily/bla.vhd</path>
				</drive>
			</device>
		</bus>

		<bus kind="pci">
			<device kind="rtl8139" id="rtl8139.1" addr="1.0">
				<network kind="slirp">
					<baseip>10.69.0.0</baseip>
				</network>
			</device>

			<device kind="aha1541" id="scsi" addr="1.1">
				<!-- aha1541 specific options -->
			</device>
		</bus>
	</devices>
</machine>
